{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://double6.local/schemas/product.schema.json",
  "title": "Double6 产品合同（提案前预检）",
  "type": "object",
  "required": ["product_id", "title", "facts", "outcomes", "work_objects", "core_flow", "capabilities", "data_policy", "device_target", "design_brief", "boundaries"],
  "properties": {
    "product_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}},
    "work_objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workObject"}},
    "core_flow": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "data_policy": {"type": "object"},
    "device_target": {"const": "responsive_both"},
    "design_brief": {"type": "object"},
    "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}}
  },
  "$defs": {
    "fact": {"type": "object", "required": ["fact_id", "text", "evidence_refs"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "outcome": {"type": "object", "required": ["outcome_id", "text"], "properties": {"outcome_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}},
    "workObject": {"type": "object", "required": ["work_object_id", "name"], "properties": {"work_object_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "capability": {"type": "object", "required": ["capability_id", "name", "description", "mode", "work_object_ids"], "properties": {"capability_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "mode": {"enum": ["in_page", "manual_handoff", "unsupported"]}, "work_object_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "boundary": {"type": "object", "required": ["boundary_id", "mode", "reason"], "properties": {"boundary_id": {"type": "string", "minLength": 1}, "mode": {"enum": ["manual_handoff", "unsupported"]}, "reason": {"type": "string", "minLength": 1}}}
  }
}
