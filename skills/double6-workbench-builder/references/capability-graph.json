    "child_learning_atoms_added": false
  },
  "source_bindings": {
    "scene_profiles": "scene-profiles.json#scene_profiles",
    "modules_and_capabilities": "domain-content-packs.json#packs[].modules[].evidence_refs",
    "capability_contracts": "scene-capability-starters.json#scenes[].capabilities",
    "atomic_capabilities": "atomic-capabilities.json#atomic_capabilities",
    "surface_primitives": "surface-primitives.json#surface_primitives",
    "policy_packs": "policy-packs.json#policy_packs"
  },
  "materialization_contract": {
    "scene_to_module": "scene_paths[].recommended_module_ids must exactly match the corresponding authoritative scene profile",
    "module_to_capability": "derive only from the selected module evidence_refs; never borrow a capability from another module",
    "capability_to_atomic_capability": [
      {
        "binding_basis": "direct_capability",
        "rule": "atom is executable_ready, names the capability_id, supports the selected module surface, and permits the domain"
      },
      {
        "binding_basis": "surface_runtime_generic",
        "rule": "atom is executable_ready, supports the selected module surface, permits the domain, and is recorded as a generic surface binding rather than a semantic CAP match"
      }
    ],
    "atomic_capability_to_surface": "use only the selected module legacy surface mapping and only when that stable surface primitive is executable_ready",
    "policy_binding": "policy IDs are requirements inherited from selected executable atoms; a contract_ready policy remains a non-executable requirement until its independent runtime promotion",
    "contract_or_catalog_binding": "exclude from executable_atom_bindings and report under excluded_non_executable_bindings",
    "empty_executable_binding": "mark the module and selection blocked; never promote registration to execution"
  },
  "selection_contract": {
    "module_min": 4,
    "module_max": 15,
    "adopt_default": "the scene profile recommended_module_ids",
    "delete_cascade": [
      "capability",
      "atomic_capability",
      "surface_primitive",
      "policy_pack"
    ],
    "capability_adjustment": "every selected capability must belong to at least one selected module and every selected module must retain at least one of its own capabilities",
    "final_snapshot": "serialize selected scene and selected module paths only; never serialize the full graph or unselected module inventory"
  },
  "clarification_contract": {
    "maximum_questions_per_scene": 5,
    "compiler_adds_questions": false,
    "scene_switch_resets_upstream_counter": true,
    "compiler_behavior": "validate an observed counter when supplied; selection compilation itself never asks another question",
    "question_budget_scope": "preferences_only",
    "authorization_questions_count_separately": true
  },
