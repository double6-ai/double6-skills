    },
    "event_types": {
      "completion_confirmed": ["completion_evidence_id", "evidence_confirmed", "completed_on", "stars optional default 1"],
      "set_reward_goal": ["goal_id", "title", "cost", "fulfillment_mode"],
      "request_redemption": ["request_id", "goal_id"],
      "confirm_redemption": ["request_id", "adult_confirmation"],
      "record_stage_celebration": ["celebration_id", "stage_evidence_id", "stage_evidence_confirmed", "label"],
      "apply_constraint": ["constraint_id", "constraint_type", "scope", "reason_code", "reversible", "quota or cooldown_until when applicable"],
      "remove_constraint": ["constraint_id", "reason_code", "adult_confirmation"],
      "expire_constraints": [],
      "grant_sensitive_data_consent": ["consent_id", "purpose", "field_scope", "storage=local_only", "explicit", "revocable", "subject_or_controller_authorized"],
      "revoke_sensitive_data_consent": ["consent_id", "adult_confirmation"],
      "request_external_operation": ["operation_id", "operation_type", "target_summary", "payload_sha256"],
      "confirm_external_operation": ["operation_id", "adult_confirmation"]
    },
    "result_contract": {
      "fields": ["ok", "status", "state", "receipt", "error"],
      "success_status": ["applied", "idempotent_replay"],
      "failure_status": "rejected",
      "receipt_invariants": ["mastery_unchanged", "business_truth_unchanged", "completion_evidence_unchanged", "external_side_effect=false"],
      "error_fields": ["code", "message", "recovery", "state_mutated=false"]
    }
  },
