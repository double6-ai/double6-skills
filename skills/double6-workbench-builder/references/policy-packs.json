      "initial_policy_state()",
      "validate_policy_state(state)",
      "apply_policy_event(state, event, context=None)",
      "reward_projection(state, as_of_date=YYYY-MM-DD)",
      "run_policy_test_vector(vector)",
      "run_policy_test_vectors(registry)"
