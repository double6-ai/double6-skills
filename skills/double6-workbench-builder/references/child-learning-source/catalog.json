          {"item_id": "english-sunny", "kind": "recognition", "prompt": "sunny 表示什么天气？", "stimulus": {"context": "天空晴朗，太阳很亮"}, "response_mode": "single_choice", "options": ["晴天", "雨天", "雪天", "大风"], "correct_answer": "晴天", "explanation": "sunny 表示有阳光的晴天。", "transfer": false},
          {"item_id": "english-blue-transfer", "kind": "recognition", "prompt": "句子“The bag is blue.”里，blue 告诉我们什么？", "stimulus": {"sentence": "The bag is blue."}, "response_mode": "single_choice", "options": ["书包是蓝色的", "书包很大", "书包在学校", "书包是新的"], "correct_answer": "书包是蓝色的", "explanation": "blue 在新句子里仍表示蓝色。", "transfer": true}
        ]
