        {"signal": "换到句子里就认不出。", "likely_cause": "只记住孤立卡片版式。", "remediation": "用同一个词造两句很短的新情境，再隐藏中文。"}
      ],
      "mastery_oracle": {"evidence_mode": "hybrid", "min_scored_trials": 4, "min_correct": 3, "required_transfer_correct": true, "max_hints": 0, "pass_state": "evidence_sufficient_for_current_atom", "fail_state": "continue_practice", "not_claimed": ["不代表会拼写", "不作发音评分", "不代表对齐指定教材"]},
