    {
      "schema_version": "child-learning-content-atom/v1",
      "atom_id": "learn-add-make-ten-100-v1",
      "version": "1.0.0",
      "title": "两位数加一位数凑整",
      "subject": "数学",
      "stage_ids": ["primary-transition-1-to-2"],
      "learner_can": "计算两位数加一位数时，能把一位数拆成“先补到整十、再加剩余”，并说出拆分过程。",
      "prerequisite_atom_ids": ["learn-count-one-to-one-20-v1"],
      "content_scope": {"included": ["和在 100 以内", "个位需要进位", "拆分一位数", "口头解释凑整"], "excluded": ["竖式", "三位数", "连续进位", "限时竞赛"]},
      "teaching_sequence": [
        {"step": 1, "teacher_action": "先问两位数离下一个整十还差几。", "learner_action": "找出补整需要的数。", "success_signal": "能说出如 28 差 2 到 30。"},
        {"step": 2, "teacher_action": "把要加的一位数拆成补整部分和剩余。", "learner_action": "说出如 7 拆成 2 和 5。", "success_signal": "拆分总和不变。"},
        {"step": 3, "teacher_action": "先完成补整，再加剩余。", "learner_action": "口头完成 28+2=30，30+5=35。", "success_signal": "结果与步骤一致。"},
        {"step": 4, "teacher_action": "换一个个位和加数，不再提示拆几。", "learner_action": "独立选择拆分并解释。", "success_signal": "新算式能迁移策略。"}
      ],
      "practice": {
        "recommended_trials": 4,
        "variation_axes": ["个位", "加数", "补整距离", "是否提供拆分提示"],
        "items": [
          {"item_id": "add-28-7", "kind": "computation", "prompt": "28 + 7 等于多少？", "stimulus": {"expression": "28 + 7", "strategy_prompt": "先补到 30"}, "response_mode": "number", "correct_answer": 35, "explanation": "7 拆成 2 和 5；28+2=30，再加 5 得 35。", "transfer": false},
          {"item_id": "add-36-8", "kind": "computation", "prompt": "36 + 8 等于多少？", "stimulus": {"expression": "36 + 8"}, "response_mode": "number", "correct_answer": 44, "explanation": "8 拆成 4 和 4；36+4=40，再加 4 得 44。", "transfer": false},
          {"item_id": "add-47-6", "kind": "computation", "prompt": "47 + 6 等于多少？", "stimulus": {"expression": "47 + 6"}, "response_mode": "number", "correct_answer": 53, "explanation": "6 拆成 3 和 3；47+3=50，再加 3 得 53。", "transfer": false},
          {"item_id": "add-59-4-transfer", "kind": "computation", "prompt": "不看提示，算出 59 + 4，并说说怎样先到整十。", "stimulus": {"expression": "59 + 4", "explanation_required": true}, "response_mode": "number", "correct_answer": 63, "explanation": "4 拆成 1 和 3；59+1=60，再加 3 得 63。", "transfer": true}
        ]
      },
      "misconceptions": [
        {"signal": "拆分后少加或多加一部分。", "likely_cause": "没有检查拆出的两数仍等于原加数。", "remediation": "拆分后先口头检查“2+5还是7”。"},
        {"signal": "看到任何题都机械补十但说不清。", "likely_cause": "只背步骤，没有理解补整目标。", "remediation": "先单练“离下一个整十差几”，再回到完整算式。"}
      ],
      "mastery_oracle": {"evidence_mode": "hybrid", "min_scored_trials": 4, "min_correct": 3, "required_transfer_correct": true, "max_hints": 0, "pass_state": "evidence_sufficient_for_current_atom", "fail_state": "continue_practice", "not_claimed": ["不代表掌握全部 100 以内加法", "不评价计算速度", "不替代书面竖式教学"]},
      "source_boundary": {"content_origin": "historical_project_evidence", "textbook_alignment": "generic_not_aligned_to_specific_textbook_region_or_exam", "real_child_validation": false, "privacy": ["不采集手写", "不上传作答", "只保留本地结果"]},
      "evidence_refs": [{"role": "historical_project_evidence", "path": "workflows/workbench-platform/examples/child-learning-v1/src/content.ts", "scope": "math-plus 的 28+7 与凑整解释"}]
