      "atom_id": "learn-hanzi-shape-sound-meaning-v1",
      "version": "1.0.0",
      "title": "汉字形—音—义识认",
      "subject": "语文",
      "stage_ids": ["primary-transition-1-to-2"],
      "learner_can": "看到一个已学常用字时，能读出字音、指出基本意思，并在另一个词语中再次认出它。",
      "prerequisite_atom_ids": [],
      "content_scope": {
        "included": ["常用独体字", "字形辨认", "口头读音", "基本字义", "换词再认"],
        "excluded": ["默写", "笔顺评分", "指定教材同步", "生僻字诊断"]
      },
      "teaching_sequence": [
        {"step": 1, "teacher_action": "先给实物、动作或熟悉情境，说出要学的意思。", "learner_action": "看情境并说出熟悉的口语词。", "success_signal": "孩子知道这个字要表达什么。"},
        {"step": 2, "teacher_action": "展示大字，慢读一次，再指出一处可辨认的字形特征。", "learner_action": "指字跟读，不要求书写。", "success_signal": "读音与目标字对应。"},
        {"step": 3, "teacher_action": "把目标字放进二选一或四选一中。", "learner_action": "从相近或相反字中找到目标字。", "success_signal": "不是靠固定位置猜中。"},
        {"step": 4, "teacher_action": "换到一个新词或新句子中再出现目标字。", "learner_action": "再次认出并说出词义。", "success_signal": "新情境仍能认出。"}
      ],
      "practice": {
        "recommended_trials": 4,
        "variation_axes": ["目标字", "干扰字", "出现位置", "词语情境"],
        "items": [
          {"item_id": "hanzi-water", "kind": "recognition", "prompt": "哪个字表示“水”？", "stimulus": {"meaning": "可以喝、会流动的水"}, "response_mode": "single_choice", "options": ["水", "火", "山", "日"], "correct_answer": "水", "explanation": "“水”读 shuǐ，表示水。", "transfer": false},
          {"item_id": "hanzi-mountain", "kind": "recognition", "prompt": "“山水”里的“山”是哪一个字？", "stimulus": {"word": "山水"}, "response_mode": "single_choice", "options": ["山", "水", "日", "月"], "correct_answer": "山", "explanation": "“山水”的第一个字是“山”。", "transfer": false},
          {"item_id": "hanzi-big", "kind": "recognition", "prompt": "看到一只很大的象，应该选哪个字？", "stimulus": {"context": "这只象很___。"}, "response_mode": "single_choice", "options": ["小", "大", "少", "口"], "correct_answer": "大", "explanation": "“大”读 dà，表示大小里的大。", "transfer": false},
          {"item_id": "hanzi-sun-transfer", "kind": "recognition", "prompt": "哪个词里有表示太阳的“日”？", "stimulus": {"target_meaning": "太阳"}, "response_mode": "single_choice", "options": ["日月", "山水", "人口", "大小"], "correct_answer": "日月", "explanation": "“日月”里的“日”可以表示太阳。", "transfer": true}
        ]
      },
      "misconceptions": [
        {"signal": "只记住选项位置，换位置就选错。", "likely_cause": "没有建立字形与意思的连接。", "remediation": "撤掉固定四选一，回到情境—大字—换位置再认。"},
        {"signal": "能跟读但单独出现认不出。", "likely_cause": "只模仿了声音。", "remediation": "让孩子先指目标字，再自己读；随后放进新词复认。"}
      ],
      "mastery_oracle": {"evidence_mode": "hybrid", "min_scored_trials": 4, "min_correct": 3, "required_transfer_correct": true, "max_hints": 0, "pass_state": "evidence_sufficient_for_current_atom", "fail_state": "continue_practice", "not_claimed": ["不代表会写这个字", "不作识字量诊断", "不代表掌握一年级写字表"]},
      "source_boundary": {"content_origin": "mixed", "textbook_alignment": "generic_not_aligned_to_specific_textbook_region_or_exam", "real_child_validation": false, "privacy": ["不录音", "不采集手写图片", "只保存本地作答事实"]},
