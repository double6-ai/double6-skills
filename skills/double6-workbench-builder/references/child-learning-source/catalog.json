    {
      "schema_version": "child-learning-content-atom/v1",
      "atom_id": "learn-count-one-to-one-20-v1",
      "version": "1.0.0",
      "title": "20 以内一一对应数数",
      "subject": "数学",
      "stage_ids": ["baby-growth-explorer", "primary-transition-1-to-2"],
      "learner_can": "面对 20 个以内、排列方式不同的一组物体，能每个只数一次，并用最后一个数表示总数。",
      "prerequisite_atom_ids": [],
      "content_scope": {"included": ["一一对应", "稳定数序", "基数概念", "直线与散乱排列", "5或10分组复核"], "excluded": ["100 以内数位", "估算", "加减运算", "速度测评"]},
      "teaching_sequence": [
        {"step": 1, "teacher_action": "把物体排开，示范手指碰一个、嘴里说一个数。", "learner_action": "边指边数，每个物体只碰一次。", "success_signal": "指点与数词一一对应。"},
        {"step": 2, "teacher_action": "问“最后说到几，所以一共有几个？”", "learner_action": "不重新数，直接说最后数词是总数。", "success_signal": "理解基数。"},
        {"step": 3, "teacher_action": "打乱位置或排成两行。", "learner_action": "选择起点和方向，避免漏数、重复。", "success_signal": "排列变化后仍正确。"},
        {"step": 4, "teacher_action": "数量较多时引导每 5 个或 10 个分一组复核。", "learner_action": "先分组，再数组内与剩余。", "success_signal": "能解释自己的防漏方法。"}
      ],
      "practice": {
        "recommended_trials": 4,
        "variation_axes": ["数量", "排列方式", "物体种类", "是否允许分组"],
        "items": [
          {"item_id": "count-seven-line", "kind": "counting", "prompt": "一共有几个圆点？", "stimulus": {"objects": ["●", "●", "●", "●", "●", "●", "●"], "layout": "line"}, "response_mode": "number", "correct_answer": 7, "explanation": "从一端开始，每个圆点只数一次，最后数到 7。", "transfer": false},
          {"item_id": "count-twelve-two-rows", "kind": "counting", "prompt": "两行星形一共有几个？", "stimulus": {"rows": [["◆", "◆", "◆", "◆", "◆", "◆"], ["◆", "◆", "◆", "◆", "◆", "◆"]]}, "response_mode": "number", "correct_answer": 12, "explanation": "可以先数第一行 6 个，再接着数第二行到 12。", "transfer": false},
          {"item_id": "count-sixteen-groups", "kind": "counting", "prompt": "先按 5 个一组，一共有几个方块？", "stimulus": {"groups": [5, 5, 5, 1], "symbol": "■"}, "response_mode": "number", "correct_answer": 16, "explanation": "三组 5 个是 15，再加 1 个是 16。", "transfer": false},
          {"item_id": "count-nineteen-scattered-transfer", "kind": "counting", "prompt": "散开的物体容易漏数。选一个起点逐个标记后，一共有几个？", "stimulus": {"count": 19, "layout": "scattered", "strategy_required": "choose_start_and_mark_once"}, "response_mode": "number", "correct_answer": 19, "explanation": "先固定起点，每数一个就做一次标记，最后的数 19 是总数。", "transfer": true}
        ]
      },
      "misconceptions": [
        {"signal": "手指移动和嘴里数词不同步。", "likely_cause": "尚未建立一一对应。", "remediation": "把物体拉开，速度放慢到一次触碰对应一个数词。"},
        {"signal": "散乱排列时漏数或重复。", "likely_cause": "没有固定起点和已数标记。", "remediation": "先圈起点，数过的移到另一边或做标记。"},
        {"signal": "数完后不能回答总数。", "likely_cause": "只背数序，未理解最后数词代表总量。", "remediation": "每次结束都追问“最后数到几，所以一共几？”"}
      ],
      "mastery_oracle": {"evidence_mode": "hybrid", "min_scored_trials": 4, "min_correct": 3, "required_transfer_correct": true, "max_hints": 0, "pass_state": "evidence_sufficient_for_current_atom", "fail_state": "continue_practice", "not_claimed": ["不代表会做加减法", "不作发展水平诊断", "不要求限时"]},
      "source_boundary": {"content_origin": "mixed", "textbook_alignment": "generic_not_aligned_to_specific_textbook_region_or_exam", "real_child_validation": false, "privacy": ["不摄像", "不记录动作视频", "只记录答案与提示次数"]},
