{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "policy",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "paragraph-link-rebind@1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "policy": {
      "const": {
        "id": "glyph-centre-annotation-v1",
        "probe_half_size_pt": 0.012,
        "glyph_position_tolerance_pt": 0.03,
        "maximum_changed_pages": 8,
        "maximum_paragraph_glyphs": 10000,
        "case_overrides_allowed": false
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "page",
          "body_size",
          "glyphs",
          "layer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "body_size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 72
          },
          "glyphs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "layer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
