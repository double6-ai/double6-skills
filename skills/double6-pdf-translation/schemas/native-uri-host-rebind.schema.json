{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "target",
    "pages",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "native-uri-host-rebind@1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "policy": {
      "const": {
        "id": "source-uri-label-padding-v1",
        "maximum_pages": 5,
        "maximum_padding_pt": 3.0,
        "continuous_fragment_tolerance_pt": 0.03,
        "saved_position_tolerance_pt": 0.03,
        "case_overrides_allowed": false
      }
    }
  }
}
