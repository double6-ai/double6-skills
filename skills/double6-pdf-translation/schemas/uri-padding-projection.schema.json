{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "target",
    "pages",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "uri-padding-projection@1"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "policy": {
      "const": {
        "id": "uniform-literal-uri-padding-v1",
        "maximum_pages": 20,
        "maximum_annotations_per_page": 1000,
        "maximum_padding_pt": 3.0,
        "source_uniformity_pt": 0.5,
        "repair_threshold_pt": 0.5,
        "saved_geometry_tolerance_pt": 0.001,
        "case_overrides_allowed": false
      }
    }
  }
}
