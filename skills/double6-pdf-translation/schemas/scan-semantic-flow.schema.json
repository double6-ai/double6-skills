{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit reviewed scan semantic flow",
  "type": "object",
  "required": [
    "source",
    "groups"
  ],
  "properties": {
    "source": {
      "$ref": "#/$defs/ref"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "region_ids",
          "target_text",
          "boundary_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "region_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "boundary_evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "blank_source_pages": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "page",
          "image_ref",
          "review_ref"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "image_ref": {
            "$ref": "#/$defs/ref"
          },
          "review_ref": {
            "$ref": "#/$defs/ref"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
