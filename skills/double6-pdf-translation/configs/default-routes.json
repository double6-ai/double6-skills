{
  "schema_version": 1,
  "development_revision": "110-unpublished",
  "entry_script": "scripts/paper_translation_workflow.py",
  "selection": "默认 translate 自动按页续译；局部风险保留原文并记录，不阻断其余页。严格验收入口另行显式调用。",
  "defaults": {
    "scan_new_input": "translate",
    "scan_reviewed_reprepare": "run-reviewed-scan",
    "scan_frozen_rebuild": "trial-render",
    "digital_pdf": "translate",
    "latex_verified": "candidate",
    "mixed_pdf": "translate",
    "long_pdf": "translate"
  },
  "routes": {
    "scan_new_input": {
      "input_family": "scanned_pdf",
      "supported_scope": "Reliable text is translated; unreliable paragraphs or unsupported pages retain original content with separate review records.",
      "action": "translate",
      "requires": [],
      "next_existing_entry": "prepare-scan",
      "default_max_pages": 2,
      "strict_inspection_entry": "inspect-input"
    },
    "scan_reviewed_reprepare": {
      "input_family": "scanned_pdf",
      "action": "run-reviewed-scan",
      "config_schema": "schemas/reviewed-scan-run.schema.json",
      "requires": [
        "existing_frozen_preparation_parent_SHA_chain"
      ],
      "model_network_required": false
    },
    "scan_frozen_rebuild": {
      "input_family": "scanned_pdf",
      "action": "trial-render",
      "requires": [
        "exact_frozen_source_contract_code_refs"
      ],
      "repeat_preparation": false,
      "model_network_required": false
    },
    "digital_pdf": {
      "input_family": "native_digital_pdf",
      "action": "translate",
      "fixed_arguments": [],
      "existing_route_unchanged": true,
      "reference": "references/release-quickstart.md",
      "legacy_strict_action": "collect or candidate"
    },
    "latex_verified": {
      "input_family": "verified_latex",
      "action": "candidate",
      "fixed_arguments": [
        "--route",
        "latex_verified"
      ],
      "existing_route_unchanged": true,
      "reference": "references/release-quickstart.md"
    },
    "translation": {
      "action": "translate",
      "input_family": "scanned_native_or_mixed_pdf",
      "failure_policy": "local_preserve_v1",
      "automatic_freeze": true,
      "per_page_resource_contract_unchanged": true,
      "local_problem": "preserve_original_region_or_page_and_continue",
      "report_location": "separate_sidecar_only",
      "resume": "--resume",
      "legacy_strict_entry": "candidate or chunked-candidate"
    }
  },
  "quality_requirements": [
    "complete_source_groups_and_roles",
    "full_semantic_review_and_required_body_repairs",
    "actual_mono_and_dual_pages",
    "actual_glyph_font_style_links_protection",
    "ordinary_reader_and_real_wholeparagraph_copy",
    "frozen_cold_rebuild",
    "only_inherit_when_source_target_actual_content_and_standard_unchanged"
  ],
  "source_policy": {
    "physical_scale": "preserve_input_media_crop_boxes",
    "hidden_OCR": "默认按实际可见页型路由；不可靠隐藏识别层不阻断其它页。",
    "handwriting_complete_work": "UNKNOWN_until_bound_source_image_review",
    "auto_model_fallback": false
  },
  "runtime": {
    "concurrency": 1,
    "task_rss_bytes": 5368709120,
    "per_job_seconds": 120,
    "same_workspace_required": false,
    "supported_platforms": [
      "macOS",
      "Linux"
    ],
    "platform_defaults": {
      "macOS": {
        "task_rss_bytes": 5368709120,
        "per_job_seconds": 120,
        "memory_metric": "rss"
      },
      "Linux": {
        "task_rss_bytes": 4294967296,
        "per_job_seconds": 300,
        "memory_metric": "pss"
      }
    },
    "override": {
      "cli": [
        "--task-memory-mib",
        "--job-timeout-seconds",
        "--memory-metric"
      ],
      "env": [
        "PAPER_TRANSLATION_TASK_MEMORY_MIB",
        "PAPER_TRANSLATION_JOB_TIMEOUT_SECONDS",
        "PAPER_TRANSLATION_MEMORY_METRIC"
      ],
      "default_max_fraction_of_physical_memory": 0.25,
      "explicit_max_fraction_of_physical_memory": 0.5,
      "frozen_contract_authoritative_for": [
        "candidate",
        "collect",
        "resume-latex"
      ],
      "override_conflict_error": "resource_override_conflicts_with_freeze"
    }
  },
  "software_release": true,
  "published_distribution": "github_release",
  "consumer": {
    "type": "skill_agent",
    "instruction_source": "SKILL.md",
    "execution_entry": "scripts/paper_translation_workflow.py",
    "selection": "read this config, classify source/task, invoke existing action directly"
  },
  "candidate_version": "2.1.0",
  "quality_requirements_scope": "这些项目约束质量接受，不再作为默认译文生成的先决阻断；问题登记在附件，正式PDF不插入审校说明。"
}
